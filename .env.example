# 이 파일을 .env 로 복사한 뒤 실제 값으로 채우세요 (.env는 git에 커밋하지 않기).

# 기상청 ASOS 일자료 조회서비스 (공공데이터포털 발급)
KMA_SERVICE_KEY=
WEATHER_STATION_ID=108

# 한국천문연구원 특일 정보 (공공데이터포털 발급)
HOLIDAY_SERVICE_KEY=

# 구글 캘린더 (학사일정 - 방학 등). 아래 NEIS 쪽이 더 간단함(카드/OAuth 불필요) - 둘 중 하나만 설정해도 됨
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_PATH=./credentials.json

# 나이스(NEIS) 교육정보 개방포털 - 구글 캘린더의 무료 대안 (open.neis.go.kr, 이메일 가입만으로 즉시 키 발급)
# SD_SCHUL_CODE를 모르면: python -m src.fetch_calendar --find-school "학교이름"
NEIS_API_KEY=
NEIS_OFFICE_CODE=B10
NEIS_SCHOOL_CODE=

# Anthropic API (선택 — 탭1 LLM 브리핑에만 사용).
# 비워두면 LLM 기능이 비활성화되고 API 호출·비용이 전혀 발생하지 않는다.
ANTHROPIC_API_KEY=
